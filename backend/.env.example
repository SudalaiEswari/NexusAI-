# ═══════════════════════════════════════════════
# NEXUS AI v2 — Environment Configuration
# Copy this to .env and fill in your values
# ═══════════════════════════════════════════════

# ── SERVER ──────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── AI PROVIDER ─────────────────────────────────
# Choose: claude | openai
# AI PROVIDER
AI_PROVIDER=gemini

# Gemini API Key
GEMINI_API_KEY= AIzaSyDVtfP_zySbr-Obo77O0JDRSsnm41VFUyo


# ── JWT AUTH ─────────────────────────────────────
JWT_SECRET=nexusai_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# ── EMAIL (Gmail SMTP) ────────────────────────────
# Enable 2FA on Gmail → App Passwords → Generate
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=NEXUS AI <your_email@gmail.com>

# ── WEB SEARCH (Tavily AI) ────────────────────────
# Free tier: https://tavily.com → 1000 searches/month free
TAVILY_API_KEY=your_tavily_api_key_here

# ── CLOUD DEPLOY (Railway / Render) ──────────────
# Set by platform automatically - no action needed
# DATABASE_URL=  (for PostgreSQL on cloud)
# FRONTEND_URL=https://your-app.up.railway.app

# ── FILE UPLOAD ───────────────────────────────────
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=uploads
